            z-index: 1500;
            transition: 0.3s;
        }
        .whatsapp-float:hover { transform: scale(1.1); }
    </style>
</head>
<body>

    <!-- CABEÇALHO -->
    <header>
        <div class="logo-area" onclick="location.reload()">
            <i class="fa-solid fa-dragon logo-icon"></i>
            <span class="logo-text">CAPANE STORE</span>
        </div>
        <nav>
            <ul>
                <li><a href="#" onclick="loadProducts()">Início</a></li>
                <li><a href="#produtos">Gold Coin</a></li>
                <li><a href="#produtos">Tibia Coin</a></li>
                <li><a href="#" onclick="openAdminModal()">Painel Admin</a></li>
            </ul>
        </nav>
        <div class="user-actions">
            <button class="cart-icon-btn" onclick="openCartModal()">
                <i class="fa-solid fa-cart-shopping"></i>
                <span class="cart-badge" id="cartBadge">0</span>
            </button>
            <button class="btn-neon" onclick="openAuthModal()">Entrar / Registrar</button>
        </div>
    </header>

    <!-- BANNER PRINCIPAL -->
    <section class="hero-banner">
        <div class="hero-content">
            <h1 class="electric-glow">SEU MERCADO DE GOLD E TIBIA COIN</h1>
            <p>Segurança, agilidade e os melhores negócios para sua jornada no Koliseu OT e Tibia.</p>
            <button class="btn-neon" style="font-size: 18px; padding: 15px 35px;" onclick="scrollToProducts()">COMPRAR AGORA</button>
        </div>
    </section>

    <!-- CATEGORIAS -->
    <div class="categories-container" id="categorias">
        <div class="section-title">
            <span>Categorias Mágicas</span>
        </div>
        <div class="cat-grid" id="categoryGrid">
            <!-- Preenchido via JS -->
        </div>
    </div>

    <!-- PRODUTOS -->
    <div class="categories-container" id="produtos">
        <div class="section-title">
            <span>Arsenal de Tesouros</span>
        </div>
        <div class="products-grid" id="productGrid">
            <!-- Preenchido via JS -->
        </div>
    </div>

    <!-- RODAPÉ -->
    <footer>
        <div class="footer-content">
            <div class="footer-col">
                <h3>CAPANE STORE</h3>
                <p>O maior e mais seguro marketplace de itens raros, gold e moedas para MMORPGs do mercado.</p>
            </div>
            <div class="footer-col">
                <h3>Links Úteis</h3>
                <ul>
                    <li><a href="#">Termos de Uso</a></li>
                    <li><a href="#">Política de Privacidade</a></li>
                    <li><a href="#">Política de Reembolso</a></li>
                    <li><a href="#">Central de Ajuda</a></li>
                </ul>
            </div>
            <div class="footer-col">
                <h3>Atendimento PIX & Suporte</h3>
                <p>Suporte 24/7 automatizado com confirmação imediata de pagamentos via PIX.</p>
            </div>
        </div>
        <p>&copy; 2026 CAPANE STORE. Todos os direitos reservados.</p>
    </footer>

    <!-- BOTÃO FLUTUANTE WHATSAPP -->
    <a href="https://wa.me/5500000000000" target="_blank" class="whatsapp-float">
        <i class="fa-brands fa-whatsapp"></i>
    </a>

    <!-- MODAL DO CARRINHO / CHECKOUT -->
    <div class="modal-overlay" id="cartModal">
        <div class="modal-content">
            <span class="close-modal" onclick="closeCartModal()">&times;</span>
            <h2 style="margin-bottom: 20px; color: var(--magenta-glow);">Carrinho de Tesouros</h2>
            <div id="cartItemsList" style="margin-bottom: 20px; max-height: 250px; overflow-y: auto;"></div>
            
            <div style="border-top: 1px solid var(--border-neon); padding-top: 15px; margin-bottom: 15px;">
                <input type="text" id="characterName" class="form-control" placeholder="Nome do Personagem (Ex: Capane Warrior)">
                <input type="text" id="serverName" class="form-control" placeholder="Servidor (Ex: Global / Koliseu OT)">
                <input type="text" id="couponCode" class="form-control" placeholder="Cupom de Desconto (Opcional)">
                <div style="display: flex; justify-content: space-between; font-size: 20px; font-weight: bold; margin-bottom: 15px;">
                    <span>Total:</span>
                    <span id="cartTotalPrice" style="color: var(--gold);">R$ 0,00</span>
                </div>
            </div>
            <button class="btn-neon" style="width: 100%; padding: 14px;" onclick="checkoutPix()">FINALIZAR COM PIX</button>
        </div>
    </div>

    <!-- MODAL DE PIX / QR CODE -->
    <div class="modal-overlay" id="pixModal">
        <div class="modal-content" style="text-align: center;">
            <span class="close-modal" onclick="closePixModal()">&times;</span>
            <h2 style="color: var(--gold); margin-bottom: 15px;">Pagamento PIX Gerado</h2>
            <p style="margin-bottom: 15px;">Escaneie o QR Code ou copie a chave PIX copia e cola abaixo:</p>
            <div id="pixQrContainer" style="margin-bottom: 15px; background: #fff; padding: 15px; display: inline-block; border-radius: 8px;">
                <!-- QR Code Imagem ou Mock -->
                <i class="fa-solid fa-qrcode" style="font-size: 120px; color: #000;"></i>
            </div>
            <textarea id="pixCopyPaste" class="form-control" readonly style="height: 80px; font-size: 12px;"></textarea>
            <p style="color: #10b981; font-weight: bold; margin-top: 10px;"><i class="fa-solid fa-spinner fa-spin"></i> Aguardando confirmação automática via webhook...</p>
        </div>
    </div>

    <!-- MODAL LOGIN / AUTH -->
    <div class="modal-overlay" id="authModal">
        <div class="modal-content">
            <span class="close-modal" onclick="closeAuthModal()">&times;</span>
            <h2 style="margin-bottom: 20px; color: var(--magenta-glow);">Acessar Conta / Cadastrar</h2>
            <input type="email" id="authEmail" class="form-control" placeholder="E-mail">
            <input type="password" id="authPassword" class="form-control" placeholder="Senha">
            <div style="display: flex; gap: 10px;">
                <button class="btn-neon" style="flex: 1;" onclick="handleLogin()">Entrar</button>
                <button class="btn-neon" style="flex: 1; background: #3b82f6;" onclick="handleRegister()">Registrar</button>
            </div>
        </div>
    </div>

    <!-- SCRIPT DE INTEGRAÇÃO FRONT-END -->
    <script>
        const API_URL = 'http://localhost:3000/api';
        let cart = JSON.parse(localStorage.getItem('capane_cart')) || [];
        let authToken = localStorage.getItem('capane_token') || '';

        document.addEventListener('DOMContentLoaded', () => {
            loadCategories();
            loadProducts();
            updateCartBadge();
        });

        function scrollToProducts() {
            document.getElementById('produtos').scrollIntoView({ behavior: 'smooth' });
        }

        async function loadCategories() {
            try {
                const res = await fetch(`${API_URL}/categories`);
                const categories = await res.json();
                const grid = document.getElementById('categoryGrid');
                grid.innerHTML = categories.map(cat => `
                    <div class="cat-card" onclick="loadProducts('${cat.slug}')">
                        <i class="fa-solid ${cat.icon || 'fa-coins'}"></i>
                        <div>${cat.name}</div>
                    </div>
                `).join('');
            } catch (err) {
                console.error("Erro ao carregar categorias:", err);
            }
        }

        async function loadProducts(categorySlug = '') {
            try {
                const url = categorySlug ? `${API_URL}/products?category=${categorySlug}` : `${API_URL}/products`;
                const res = await fetch(url);
                const products = await res.json();
                const grid = document.getElementById('productGrid');
                
                if (products.length === 0) {
                    grid.innerHTML = `<p style="grid-column: 1/-1; text-align: center; color: var(--text-muted);">Nenhum tesouro encontrado nesta categoria.</p>`;
                    return;
                }

                grid.innerHTML = products.map(prod => `
                    <div class="product-card">
                        <div class="product-img">
                            <i class="fa-solid fa-gem"></i>
                        </div>
                        <div class="product-info">
                            <div>
                                <div class="product-title">${prod.name}</div>
                                <div class="stock-badge"><i class="fa-solid fa-box"></i> Estoque: ${prod.stock.toLocaleString()}</div>
                                <div class="product-price">R$ ${parseFloat(prod.price).toFixed(2)}</div>
                            </div>
                            <button class="btn-neon" style="width: 100%;" onclick="addToCart(${prod.id}, '${prod.name}', ${prod.price})">Adicionar ao Carrinho</button>
                        </div>
                    </div>
                `).join('');
            } catch (err) {
                console.error("Erro ao carregar produtos:", err);
            }
        }

        function addToCart(id, name, price) {
            const existing = cart.find(item => item.id === id);
            if (existing) {
                existing.quantity += 1;
            } else {
                cart.push({ id, name, price, quantity: 1 });
            }
            saveCart();
            alert(`${name} adicionado ao carrinho!`);
        }

        function saveCart() {
            localStorage.setItem('capane_cart', JSON.stringify(cart));
            updateCartBadge();
        }

        function updateCartBadge() {
            const total = cart.reduce((sum, item) => sum + item.quantity, 0);
            document.getElementById('cartBadge').innerText = total;
        }

        function openCartModal() {
            const list = document.getElementById('cartItemsList');
            if (cart.length === 0) {
                list.innerHTML = `<p style="text-align: center; color: var(--text-muted);">Seu carrinho está vazio.</p>`;
                document.getElementById('cartTotalPrice').innerText = 'R$ 0,00';
            } else {
                let total = 0;
                list.innerHTML = cart.map((item, index) => {
                    const subtotal = item.price * item.quantity;
                    total += subtotal;
                    return `
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; border-bottom: 1px dashed var(--border-neon); padding-bottom: 8px;">
                            <div>
                                <strong>${item.name}</strong><br>
                                <small>Qtd: ${item.quantity} x R$ ${item.price.toFixed(2)}</small>
                            </div>
                            <div>
                                <span style="color: var(--gold); font-weight: bold;">R$ ${subtotal.toFixed(2)}</span>
                                <button onclick="removeFromCart(${index})" style="background:none; border:none; color: #ef4444; cursor:pointer; margin-left:10px;"><i class="fa-solid fa-trash"></i></button>
                            </div>
                        </div>
                    `;
                }).join('');
                document.getElementById('cartTotalPrice').innerText = `R$ ${total.toFixed(2)}`;
            }
            document.getElementById('cartModal').style.display = 'flex';
        }

        function removeFromCart(index) {
            cart.splice(index, 1);
            saveCart();
            openCartModal();
        }

        function closeCartModal() { document.getElementById('cartModal').style.display = 'none'; }
        function openAuthModal() { document.getElementById('authModal').style.display = 'flex'; }
        function closeAuthModal() { document.getElementById('authModal').style.display = 'none'; }
        function closePixModal() { document.getElementById('pixModal').style.display = 'none'; }

        async function handleLogin() {
            const email = document.getElementById('authEmail').value;
            const password = document.getElementById('authPassword').value;
            try {
                const res = await fetch(`${API_URL}/auth/login`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ email, password })
                });
                const data = await res.json();
                if (data.token) {
                    authToken = data.token;
                    localStorage.setItem('capane_token', data.token);
                    alert('Login realizado com sucesso!');
                    closeAuthModal();
                } else {
                    alert(data.error || 'Erro ao autenticar.');
                }
            } catch (err) { alert('Erro de conexão.'); }
        }

        async function handleRegister() {
            const email = document.getElementById('authEmail').value;
            const password = document.getElementById('authPassword').value;
            const name = prompt("Informe seu nome completo:");
            if (!name) return;
            try {
                const res = await fetch(`${API_URL}/auth/register`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ name, email, password })
                });
                const data = await res.json();
                if (data.token) {
                    authToken = data.token;
                    localStorage.setItem('capane_token', data.token);
                    alert('Cadastro e login realizados com sucesso!');
                    closeAuthModal();
                } else {
                    alert(data.error || 'Erro no cadastro.');
                }
            } catch (err) { alert('Erro de conexão.'); }
        }

        async function checkoutPix() {
            if (!authToken) {
                alert('Você precisa estar logado para finalizar o pedido.');
                openAuthModal();
                return;
            }
            const character_name = document.getElementById('characterName').value;
            const server_name = document.getElementById('serverName').value;
            const coupon_code = document.getElementById('couponCode').value;

            if (!character_name || !server_name) {
                alert('Informe o nome do personagem e o servidor para a entrega.');
                return;
            }

            const items = cart.map(item => ({ product_id: item.id, quantity: item.quantity }));

            try {
                const res = await fetch(`${API_URL}/orders`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${authToken}`
                    },
                    body: JSON.stringify({ items, character_name, server_name, coupon_code })
                });
                const data = await res.json();
                if (data.success) {
                    closeCartModal();
                    cart = [];
                    saveCart();
                    document.getElementById('pixCopyPaste').value = data.pix.copy_paste;
                    document.getElementById('pixModal').style.display = 'flex';
                } else {
                    alert(data.error || 'Erro ao gerar pedido.');
                }
            } catch (err) { alert('Erro ao processar checkout.'); }
        }

        function openAdminModal() {
            if (!authToken) {
                alert('Faça login com uma conta de Administrador.');
                openAuthModal();
                return;
            }
            // Redirecionamento ou exibição do painel admin
            fetch(`${API_URL}/admin/dashboard`, {
                headers: { 'Authorization': `Bearer ${authToken}` }
            }).then(res => res.json()).then(data => {
                if (data.error) {
                    alert('Acesso negado: Administrador necessário.');
                } else {
                    alert(`Painel Administrativo:\nFaturamento Total: R$ ${data.faturamento_total}\nVendas Hoje: R$ ${data.vendas_hoje}\nPedidos Pendentes: ${data.pedidos_pendentes}`);
                }
            }).catch(() => alert('Erro ao validar privilégios de administrador.'));
        }
    </script>
</body>
</html>

```
## 🚀 Instruções de Instalação e Implantação
 1. **Banco de Dados**: Crie um banco PostgreSQL (na sua máquina ou em provedores como Supabase, Railway ou Render) e execute o script contido em schema.sql.
 2. **Backend**:
   * Crie uma pasta para o projeto, salve o arquivo server.js e execute npm init -y, seguido de npm install express pg bcryptjs jsonwebtoken cors dotenv axios.
   * Crie um arquivo .env contendo:
     ```env
     PORT=3000
     DATABASE_URL=sua_url_de_conexao_postgresql
     JWT_SECRET=sua_chave_secreta_jwt
     PIX_API_URL=url_opcional_da_api_do_gateway_pagamento
     PIX_TOKEN=token_do_gateway
     
     ```
   * Inicie o servidor: node server.js.
 3. **Front-End**: Salve o código HTML/CSS/JS em um arquivo index.html e abra-o no navegador ou faça o deploy estático em plataformas como Vercel, Netlify ou GitHub Pages apontando para o seu backend.